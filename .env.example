# Judge credentials. Copy to .env (git-ignored) or export in your shell.
#
# Any OpenAI-compatible endpoint works; the model id is recorded in every report
# because invocation rate is a property of (page, client, judge model).
#
# The frozen Airlock utterance set was authored by "deepseek v4 by agentrouter",
# so that model must not be used as the judge for those numbers.

WEBMCP_GAUGE_JUDGE_API_KEY=
WEBMCP_GAUGE_JUDGE_BASE_URL=https://agentrouter.org/v1
WEBMCP_GAUGE_JUDGE_MODEL=glm-5.3

# Chrome debugging port for the flagged browser (see docs/getting-started.md 1.1).
# 9222 is occupied on the author's machine by an unrelated Chrome that answers
# 404 on /json/version, hence the non-default default.
CDP_PORT=9333
